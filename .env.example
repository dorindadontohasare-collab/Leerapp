# ============ StudyBase configuratie ============
# Kopieer dit bestand naar .env en vul de waarden in.

# Geheim voor sessie-tokens (verplicht, minimaal 32 tekens)
AUTH_SECRET=verander-dit-in-een-lange-random-string

# AI-modellen (Mistral). Zonder sleutel tonen AI-functies de status
# "Niet geconfigureerd" en werken de niet-AI-onderdelen gewoon.
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Optioneel: basis-URL van de app (voor PWA en e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
